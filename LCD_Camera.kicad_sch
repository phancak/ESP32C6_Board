	)
	(text "The OV5640 internally generates 1.5V DVDD \nfrom AVDD (2.8V) using an onboard LDO\nIf the internal regulator is enabled, DVDD \nshould be left floating (not connected externally)."
		(exclude_from_sim no)
		(at 145.796 -69.85 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "12632adc-9664-4598-82c8-c69a1ee51e5e")
	)
	(text "R_SET = 200 mV / 120 mA = 1.67 Ω \n(use 1.6 Ω or 1.8 Ω standard)"
		(exclude_from_sim no)
		(at 191.77 144.018 0)
		(effects
			(font
				(size 1 1)
			)
		)
		(uuid "15b542ac-9d41-4619-a6de-5721e56c8163")
	)
	(text "Connector for\nwww.aliexpress.com/item/1005008632320232.html\nILI9488 LCD, SSD1963"
		(exclude_from_sim no)
		(at 70.866 27.432 0)
		(effects
			(font
